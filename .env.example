# Wind tunnel — remote brain connection settings.
# Copy this file to `.env` and fill in your values. `.env` is never committed.
# Precedence: CLI --base-url  >  this file  >  config/models.yaml profile.
# Nothing runs locally: the runtime only ever CALLS the endpoint.

# OpenAI-compatible base URL of your remote vLLM (or any compatible server).
# Port in your setup:
BRAIN_BASE_URL=https://maas-openapi.wanjiedata.com/api/v1

# API key (use "EMPTY" if your vLLM has no auth enabled).
# Never commit a real key — not even in this example file.
BRAIN_API_KEY=sk-your-key-here

# Served model id exactly as `GET /v1/models` reports it.
BRAIN_MODEL=glm-5.3-flash
