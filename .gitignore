# Credentials. The remote-brain key lives here and never leaves the machine.
.env

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store

# Scratch output: smoke runs, live tests, and the explainer-video frames
# (~3.9k PNGs plus wav, ~192 MB; `python3 tools/make_video.py` rebuilds them,
# the rendered mp4 is committed). `make clean` deletes this folder only.
runs/scratch/

# Dashboard data is inlined into site/dashboard.html; the standalone copy is
# for inspection only.
site/*.data.json

# Run artifacts. The bulk logs are reproducible from the committed code, panel
# and scenarios — `make demo` rebuilds them offline in about 11 s — so only the
# auditable parts are versioned: manifest.json (five-tuple, code_hash,
# prompt_sha8), summary.json, report.md and results.json.
runs/**/events.jsonl
runs/**/intents.jsonl
runs/**/marks.jsonl
runs/**/trades.jsonl
runs/**/violations.jsonl
runs/**/llm_cache.json
runs/**/viewer.html
